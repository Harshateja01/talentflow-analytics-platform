# ==============================================================================
# TalentFlow Environment Configuration
# ==============================================================================

# Execution Mode: "local" (default, DuckDB warehouse) or "gcp" (BigQuery warehouse)
TALENTFLOW_MODE=local

# Data Directory (for synthetic CSVs and local DuckDB warehouse)
TALENTFLOW_DATA_DIR=./data

# ==============================================================================
# Google Cloud Platform (Required only when TALENTFLOW_MODE=gcp)
# ==============================================================================
# GCP Project ID hosting BigQuery datasets (Required in GCP mode)
GCP_PROJECT_ID=talentflow-analytics

# BigQuery Dataset Location
GCP_REGION=us-central1

# Authentication:
# By default, TalentFlow uses Google Cloud Application Default Credentials (ADC)
# initialized via: `gcloud auth application-default login`
# If you prefer a service-account JSON key, uncomment and set the path below:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional GCS Landing Zone Bucket:
# If left empty, TalentFlow runs in BigQuery-Only mode, loading Pandas DataFrames
# directly via client.load_table_from_dataframe() without needing Cloud Storage.
# If set, raw CSV extracts are also archived to gs://${GCS_BUCKET_NAME}/raw/
# GCS_BUCKET_NAME=talentflow-data-lake-bucket

# BigQuery Dataset Names
BQ_RAW_DATASET=talentflow_raw
BQ_STAGING_DATASET=talentflow_staging
BQ_ANALYTICS_DATASET=talentflow_analytics

# ==============================================================================
# AI / Natural Language Insights (Optional)
# ==============================================================================
# Gemini API Key for NL executive insights; fallback deterministic engine active if omitted
# GEMINI_API_KEY=your-gemini-api-key-here
