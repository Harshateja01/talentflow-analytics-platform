# ==============================================================================
# TalentFlow Environment Configuration
# ==============================================================================

# Execution Mode: "local" (default, DuckDB warehouse) or "gcp" (BigQuery + GCS)
TALENTFLOW_MODE=local

# Data Directory (for synthetic CSVs and local warehouse)
TALENTFLOW_DATA_DIR=./data

# Google Cloud Platform (Required only when TALENTFLOW_MODE=gcp)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=talentflow-data-lake-bucket
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# BigQuery Dataset Names
BQ_RAW_DATASET=talentflow_raw
BQ_STAGING_DATASET=talentflow_staging
BQ_ANALYTICS_DATASET=talentflow_analytics

# Optional Gemini API Key for Natural Language Analytics Insights
GEMINI_API_KEY=your-gemini-api-key-here
